# Database — SQLite file. Locally a relative path; in Docker/NAS a path on the
# mounted volume (see docker-compose.yml).
DATABASE_URL="file:./dev.db"

# NextAuth — required. Generate a long random string for production.
NEXTAUTH_SECRET="replace-with-a-long-random-secret-string"

# Public URL the app is served from (e.g. http://your-nas-host:3000)
NEXTAUTH_URL="http://localhost:3000"
# On the NAS this must be the public Cloudflare hostname: https://epl.eusoof.com

# football-data.org free API token (Admin → Schedule import/sync).
# Get a free key at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""
